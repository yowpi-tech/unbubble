        "BEFREE_BUBBLE_MCP_CONFIG_DIR=/tmp/unbubble-demo-befree",
        "npx",
        "next",
        "dev",
        "-p",
        "3334"
      ],
      "cwd": "ui",
      "port": 3334
    }
  ]
}
