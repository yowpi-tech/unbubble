# Optional overrides — defaults work out of the box.
# Where the pipeline writes project folders (default: ~/UnBubble-Projects)
# UNBUBBLE_PROJECTS_DIR=/Users/you/UnBubble-Projects
# Where the UnBubble repo lives (default: the parent folder of ui/)
# UNBUBBLE_REPO_DIR=/Users/you/UnBubble
# The connected mode's state folder (default: ~/.unbubble/mcp — same variable as mcp/launch.py)
# UNBUBBLE_MCP_HOME=/Users/you/.unbubble/mcp
